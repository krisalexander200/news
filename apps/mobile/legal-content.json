  "privacy": [
    {
      "type": "h1",
      "runs": [
        {
          "text": "NewsDrip Privacy Policy",
          "href": null
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "Effective date: October 3, 2026",
          "href": null
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "This Privacy Policy explains how NewsDrip (\"we\", \"us\", or \"our\") handles information when you use the NewsDrip mobile app and web app.",
          "href": null
        }
      ]
    },
    {
      "type": "h2",
      "runs": [
        {
          "text": "Information We Collect",
          "href": null
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "NewsDrip is designed to minimize data collection.",
          "href": null
        }
      ]
    },
    {
      "type": "li",
      "runs": [
        {
          "text": "We do not require account registration.",
          "href": null
        }
      ]
    },
    {
      "type": "li",
      "runs": [
        {
          "text": "We do not ask you to provide personal profile information to use the app.",
          "href": null
        }
      ]
    },
    {
      "type": "li",
      "runs": [
        {
          "text": "We do not sell personal data.",
          "href": null
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "Our hosting provider may automatically process technical request data such as IP address, device/browser metadata, and server logs for security, reliability, and diagnostics.",
          "href": null
        }
      ]
    },
    {
      "type": "h2",
      "runs": [
        {
          "text": "How We Use Information",
          "href": null
        }
      ]
    },
    {
      "type": "li",
      "runs": [
        {
          "text": "To deliver news headline links from RSS feeds.",
          "href": null
        }
      ]
    },
    {
      "type": "li",
      "runs": [
        {
          "text": "To operate, secure, and debug the service.",
          "href": null
        }
      ]
    },
    {
      "type": "li",
      "runs": [
        {
          "text": "To improve reliability and performance.",
          "href": null
        }
      ]
    },
    {
      "type": "h2",
      "runs": [
        {
          "text": "Data Sources and Sharing",
          "href": null
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "News headline links are aggregated by our backend from publisher RSS feeds and selected feed intermediaries. The Sources page lists the publications and identifies intermediary feeds. The app does not send user content to an AI service and displays images supplied in RSS feed image fields. When you open an article, you are sent to that publisher's website and their privacy policy applies there.",
          "href": null
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "We may use third-party infrastructure providers (such as cloud hosting) to run the service. These providers may process technical data needed to host and secure the app.",
          "href": null
        }
      ]
    },
    {
      "type": "h2",
      "runs": [
        {
          "text": "Data Retention",
          "href": null
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "News items are cached briefly to improve performance. Technical logs are retained only as needed for operations, security, and legal compliance, based on provider defaults and our operational needs.",
          "href": null
        }
      ]
    },
    {
      "type": "h2",
      "runs": [
        {
          "text": "Children's Privacy",
          "href": null
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "NewsDrip is not directed to children under 13, and we do not knowingly collect personal information from children.",
          "href": null
        }
      ]
    },
    {
      "type": "h2",
      "runs": [
        {
          "text": "Your Rights",
          "href": null
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "Depending on your location, you may have rights related to access, deletion, or objection regarding personal information. Because we do not maintain user accounts or user profiles, our ability to identify and act on a specific request may be limited.",
          "href": null
        }
      ]
    },
    {
      "type": "h2",
      "runs": [
        {
          "text": "Changes to This Policy",
          "href": null
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "We may update this policy from time to time. The \"Effective date\" at the top indicates the latest revision date.",
          "href": null
        }
      ]
    },
